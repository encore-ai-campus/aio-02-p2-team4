flowchart LR
    subgraph FRONTEND["Frontend · 사용자 화면"]
        direction TB
        USER["사용자"] --> UI["Next.js 화면"]
        UI --> PROXY["서버 프록시 · Vercel"]
    end

    subgraph BACKEND["Backend · 요청 처리"]
        direction TB
        API["FastAPI"] --> GRAPH["LangGraph · 검증 흐름 제어"]
        API --> AUX["보조 API · 의도·요약·JEV"]
        API --> CONV["대화 저장 API"]
        GRAPH --> ADAPTERS["검색·원문·모델·JEV 어댑터"]
    end

    subgraph DATA["Data · 처리 상태와 저장소"]
        direction TB
        STATE["FactCheckState · 주장·출처·근거·진단"]
        RESULT["응답 데이터 · 판정·인용·출처"]
        DB[("Render PostgreSQL · conversations / messages")]
    end

    subgraph EXTERNAL["External services · 외부 서비스"]
        direction TB
        SEARCH["Tavily · LLM 웹 검색"]
        SOURCES["웹 원문 · YouTube 자막"]
